% ---------------------------------------------------------------------------
% spconf.sty  --  LOCAL STAND-IN ONLY.
% This is NOT the official ICASSP style file. It reproduces the page geometry
% and the \name / \address / \ninept interface closely enough that the draft
% compiles and paginates approximately correctly.
%
% BEFORE SUBMITTING: delete this file and drop in the official spconf.sty
% (and IEEEbib.bst) from the ICASSP author kit. No change to main.tex is
% needed.
% ---------------------------------------------------------------------------
\ProvidesPackage{spconf}[2026/01/01 local stand-in for ICASSP spconf]

\RequirePackage{ifthen}

% ---- page geometry (approximates the ICASSP letterpaper layout) ----
\setlength{\paperwidth}{8.5in}
\setlength{\paperheight}{11in}
\setlength{\textwidth}{7.0in}
\setlength{\textheight}{9.0in}
\setlength{\oddsidemargin}{-0.25in}
\setlength{\evensidemargin}{-0.25in}
\setlength{\topmargin}{-0.5in}
\setlength{\headheight}{0pt}
\setlength{\headsep}{0pt}
\setlength{\columnsep}{0.3in}
\setlength{\parindent}{1.5em}
\twocolumn
\sloppy
\flushbottom

% ---- 9pt body text ----
\def\ninept{\def\baselinestretch{.95}\let\normalsize\small\normalsize}

% ---- title block ----
\newcommand{\name}[1]{\gdef\@sp@name{#1}}
\newcommand{\address}[1]{\gdef\@sp@address{#1}}
\newcommand{\twoauthors}[4]{%
  \gdef\@sp@name{\begin{tabular}{c@{\hspace{3em}}c}#1 & #3\\[2pt]#2 & #4\end{tabular}}%
  \gdef\@sp@address{}}
\gdef\@sp@name{}
\gdef\@sp@address{}

\renewcommand{\maketitle}{%
  \twocolumn[%
    \begin{center}
      {\Large\bfseries \@title \par}\vspace{1.2em}
      {\normalsize \@sp@name \par}\vspace{0.6em}
      {\normalsize\itshape \@sp@address \par}\vspace{1.4em}
    \end{center}%
  ]%
}

% ---- abstract / keywords ----
\renewenvironment{abstract}{%
  \centerline{\bfseries ABSTRACT}\vspace{0.4em}\small\itshape}{\par\vspace{0.6em}}

\newenvironment{keywords}{%
  \vspace{0.2em}\noindent{\bfseries\itshape Index Terms}\textemdash\itshape\small}{\par\vspace{0.8em}}

% ---- section headings in ICASSP small caps / uppercase style ----
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {2.0ex plus 1ex minus .2ex}{1.2ex plus .2ex}%
  {\centering\normalsize\bfseries\MakeUppercase}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {1.6ex plus 1ex minus .2ex}{1.0ex plus .2ex}{\normalsize\bfseries}}

\endinput
